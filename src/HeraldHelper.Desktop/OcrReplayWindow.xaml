<Window x:Class="HeraldHelper.Desktop.OcrReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="OCR Replay"
        Width="980" Height="640" MinWidth="720" MinHeight="420"
        Background="{DynamicResource VsWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Click="Refresh_Click"
                        ToolTip="Rescan the replay folder">
                    <TextBlock Text="Refresh" />
                </Button>
                <Button Margin="6,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OpenFolder_Click"
                        ToolTip="Open the replay folder in Explorer">
                    <TextBlock Text="Open Folder" />
                </Button>
            </StackPanel>
            <ListBox x:Name="RecordList"
                     Style="{StaticResource SidebarListBoxStyle}"
                     ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                     SelectionChanged="RecordList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource VsMutedTextBrush}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Center"
                      Background="Transparent" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,0,8">
                <ComboBox x:Name="CaptureCombo"
                          Width="260"
                          Style="{StaticResource CompactInputComboBoxStyle}"
                          materialDesign:HintAssist.Hint="Capture"
                          DisplayMemberPath="Label"
                          SelectionChanged="CaptureCombo_SelectionChanged" />
                <TextBlock x:Name="RecordInfoText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource VsMutedTextBrush}" />
            </WrapPanel>

            <GroupBox Header="Capture">
                <Grid>
                    <Image x:Name="CaptureImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="NoCaptureText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource VsMutedTextBrush}"
                               Text="Pick a record on the left." />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Margin="0,10,0,0" Header="OCR text + parse result">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OcrTextBox"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource VsPanelAltBrush}"
                             Foreground="{DynamicResource VsTextBrush}"
                             BorderBrush="{DynamicResource VsBorderBrush}" />
                    <TextBox Grid.Column="1"
                             x:Name="ParseResultBox"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Margin="8,0,0,0"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource VsPanelAltBrush}"
                             Foreground="{DynamicResource VsTextBrush}"
                             BorderBrush="{DynamicResource VsBorderBrush}" />
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
