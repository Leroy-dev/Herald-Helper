<Window x:Class="HeraldHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:HeraldHelper.Desktop.Views"
        mc:Ignorable="d"
        TextElement.FontSize="13"
        TextElement.FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        Title="HeraldHelper" Height="820" Width="1220" MinHeight="720" MinWidth="1080"
        Background="{DynamicResource VsWindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel LastChildFill="True" Background="{DynamicResource VsWindowBackgroundBrush}">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Background="{DynamicResource VsTitleBarBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="HeraldHelper" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="ThemeToggleButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="Light Mode"
                            ToolTip="Toggle between dark and light mode"
                            Click="ToggleTheme_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="OpenAppearanceSettings_Click"
                            ToolTip="Appearance settings">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource VsTitleBarBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock Name="RegionText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource VsMutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Name="LoopStatusText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource VsMutedTextBrush}"
                           Text="Loop stopped" />
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource VsPanelBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="SelectChatArea_Click" ToolTip="Select the chat log capture region">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chat" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Chat" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="SelectStatsArea_Click" ToolTip="Select the player stats capture region">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Stats" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="6,4" VerticalAlignment="Stretch" Width="1" Background="{DynamicResource VsBorderBrush}" />
                    <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="RunTick_Click" ToolTip="Run a single OCR/parsing tick">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Tick" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Name="ToggleLoopButton" Click="ToggleLoop_Click" ToolTip="Start or stop the background loop">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Name="ToggleLoopIcon" Kind="Run" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Name="ToggleLoopText" Text="Start" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="6,4" VerticalAlignment="Stretch" Width="1" Background="{DynamicResource VsBorderBrush}" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OpenSpellBrowser_Click" ToolTip="Open the spell catalog browser">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpen" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Spells" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OpenEdenBrowser_Click" ToolTip="Open the item/eden browser">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Browser" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="6,4" VerticalAlignment="Stretch" Width="1" Background="{DynamicResource VsBorderBrush}" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="RefreshAuthCurrent_Click" ToolTip="Refresh auth for the current shard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Auth" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="RefreshAuthAll_Click" ToolTip="Refresh auth for all shards">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSync" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Auth all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150"
                              Name="ShardCombo"
                              Style="{StaticResource CompactInputComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Mode / Shard"
                              ToolTip="Choose the active shard/mode"
                              SelectionChanged="ShardCombo_SelectionChanged" />
                    <TextBox Margin="6,0,0,0"
                             Width="70"
                             Name="ResistText"
                             Style="{StaticResource CompactInputTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Resist %"
                             ToolTip="Base resist percentage used for rough damage estimates"
                             TextChanged="ResistText_TextChanged" />
                    <TextBox Margin="6,0,0,0"
                             Width="80"
                             Name="LoopMsText"
                             Style="{StaticResource CompactInputTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Loop ms"
                             ToolTip="Background loop interval in milliseconds"
                             Text="350"
                             TextChanged="LoopMsText_TextChanged" />
                    <ComboBox Margin="6,0,0,0"
                              Width="130"
                              Name="OcrEngineCombo"
                              Style="{StaticResource CompactInputComboBoxStyle}"
                              materialDesign:HintAssist.Hint="OCR Engine"
                              ToolTip="OCR engine selection: adaptive, Tesseract only, or Windows OCR only"
                              SelectionChanged="OcrEngineCombo_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    MinWidth="170"
                    MaxWidth="180"
                    Background="{DynamicResource VsPanelBrush}"
                    BorderBrush="{DynamicResource VsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox Name="SidebarList"
                         Style="{StaticResource SidebarListBoxStyle}"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SidebarList_SelectionChanged">
                    <ListBoxItem Tag="Live" IsSelected="True" ToolTip="Live status and diagnostics (Alt+1)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartPulse" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Live" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Config" ToolTip="DAoC character and configuration (Alt+2)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Config" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Abilities" ToolTip="Ability profiles and catalogs (Alt+3)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flash" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Abilities" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Overlay" ToolTip="Overlay position, size and colors (Alt+4)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Overlay" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Herald" ToolTip="Search cached player profiles (Alt+5)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Herald" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <views:LiveView x:Name="LiveView" Visibility="Visible" />
                <views:ConfigView x:Name="ConfigView" Visibility="Collapsed" />
                <views:AbilitiesView x:Name="AbilitiesView" Visibility="Collapsed" />
                <views:OverlayView x:Name="OverlayView" Visibility="Collapsed" />
                <views:HeraldView x:Name="HeraldView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
