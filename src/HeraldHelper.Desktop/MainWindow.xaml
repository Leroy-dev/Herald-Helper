<Window x:Class="HeraldHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.FontSize="13"
        TextElement.FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        Title="HeraldHelper" Height="820" Width="1220" MinHeight="720" MinWidth="1080"
        Background="{DynamicResource VsWindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource VsAccentBrush}"
                                BorderThickness="0,0,0,0"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource VsPanelAltBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2,0,0,0" />
                                <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource VsPanelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource VsPanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource VsAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="CompactInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Background" Value="{DynamicResource VsPanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CompactInputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Background" Value="{DynamicResource VsPanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource VsPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VsBorderBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource VsPanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource VsPanelAltBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource VsBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource VsBorderBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{DynamicResource VsWindowBackgroundBrush}">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Background="{DynamicResource VsTitleBarBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="HeraldHelper" />
                <Button Grid.Column="2"
                        Name="ThemeToggleButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="Light Mode"
                        Click="ToggleTheme_Click" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource VsTitleBarBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Name="RegionText"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource VsMutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource VsPanelBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Select Chat Area" Click="SelectChatArea_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Select Stats Area" Click="SelectStatsArea_Click" />
                    <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Run One Tick" Click="RunTick_Click" />
                    <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Name="ToggleLoopButton" Content="Start Loop" Click="ToggleLoop_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Spell Browser" Click="OpenSpellBrowser_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Browser" Click="OpenEdenBrowser_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Refresh Auth (Shard)" Click="RefreshAuthCurrent_Click" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Refresh Auth (All)" Click="RefreshAuthAll_Click" />
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150"
                              Name="ShardCombo"
                              Style="{StaticResource CompactInputComboBoxStyle}"
                              materialDesign:HintAssist.Hint="Mode / Shard"
                              SelectionChanged="ShardCombo_SelectionChanged" />
                    <TextBox Margin="6,0,0,0"
                             Width="70"
                             Name="ResistText"
                             Style="{StaticResource CompactInputTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Resist %"
                             TextChanged="ResistText_TextChanged" />
                    <TextBox Margin="6,0,0,0"
                             Width="80"
                             Name="LoopMsText"
                             Style="{StaticResource CompactInputTextBoxStyle}"
                             materialDesign:HintAssist.Hint="Loop ms"
                             Text="350"
                             TextChanged="LoopMsText_TextChanged" />
                    <ComboBox Margin="6,0,0,0"
                              Width="130"
                              Name="OcrEngineCombo"
                              Style="{StaticResource CompactInputComboBoxStyle}"
                              materialDesign:HintAssist.Hint="OCR Engine"
                              SelectionChanged="OcrEngineCombo_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    MinWidth="170"
                    MaxWidth="180"
                    Background="{DynamicResource VsPanelBrush}"
                    BorderBrush="{DynamicResource VsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox Name="SidebarList"
                         Style="{StaticResource SidebarListBoxStyle}"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         SelectionChanged="SidebarList_SelectionChanged">
                    <ListBoxItem Tag="Live" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartPulse" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Live" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Config">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Config" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Abilities">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flash" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Abilities" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Overlay">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" Margin="0,0,10,0" Foreground="{DynamicResource VsTextBrush}" />
                            <TextBlock Text="Overlay" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid x:Name="LivePanel" Margin="16" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Status">
                            <TextBox Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource VsPanelAltBrush}" Foreground="{DynamicResource VsTextBrush}" BorderBrush="{DynamicResource VsBorderBrush}" />
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="OCR Diagnostics">
                            <TextBox Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource VsPanelAltBrush}" Foreground="{DynamicResource VsTextBrush}" BorderBrush="{DynamicResource VsBorderBrush}" />
                        </GroupBox>
                        <GroupBox Grid.Row="2" Header="Response Diagnostics">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Style="{StaticResource ToolbarButtonStyle}" Content="Clear Log" Click="ClearResponseDiagnostics_Click" />
                                </WrapPanel>
                                <TextBox Grid.Row="1"
                                         Name="ResponseDiagnosticsBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource VsPanelAltBrush}"
                                         Foreground="{DynamicResource VsTextBrush}"
                                         BorderBrush="{DynamicResource VsBorderBrush}" />
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Grid x:Name="ConfigPanel" Margin="16" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="DAoC Characters">
                            <StackPanel Name="DaocCharacterPanel" />
                        </GroupBox>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Reload Config" Click="ReloadConfig_Click" />
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Save Config" Click="SaveConfig_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Export JSON" Click="ExportJson_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Import JSON" Click="ImportJson_Click" />
                        </WrapPanel>
                        <DataGrid Grid.Row="2"
                                  Name="ConfigGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="300" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="AbilitiesPanel" Margin="16" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10">
                            <ComboBox Width="170"
                                      Name="AbilityProfileServerCombo"
                                      Style="{StaticResource CompactInputComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Ability Server"
                                      SelectionChanged="AbilityProfileServerCombo_SelectionChanged" />
                            <ComboBox Margin="8,0,0,0"
                                      Width="200"
                                      Name="AbilityProfileClassCombo"
                                      Style="{StaticResource CompactInputComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="Active Class"
                                      SelectionChanged="AbilityProfileClassCombo_SelectionChanged" />
                            <TextBlock Margin="12,0,0,0"
                                       Name="AbilityProfileSummaryText"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource VsMutedTextBrush}" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Reload Abilities" Click="ReloadAbilities_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Reload Local Catalogs" Click="ReloadAbilityCatalogs_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Update Catalogs Online" Click="UpdateCatalogsOnline_Click" />
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Save Abilities" Click="SaveAbilities_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Add Ability" Click="AddAbility_Click" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Remove Selected" Click="RemoveAbility_Click" />
                        </WrapPanel>
                        <DataGrid Grid.Row="2"
                                  Name="AbilitiesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                <DataGridTextColumn Header="Ability Name" Binding="{Binding AbilityName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="OCR Aliases" Binding="{Binding Aliases, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                <DataGridTextColumn Header="Skill Code" Binding="{Binding SkillCode, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="Effect Type" Binding="{Binding EffectType, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="OverlayPanel" Margin="16" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Reload Overlay Settings" Click="ReloadOverlaySettings_Click" />
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Save Overlay Settings" Click="SaveOverlaySettings_Click" />
                        </WrapPanel>

                        <GroupBox Grid.Row="1" Header="Overlay Elements">
                            <WrapPanel Margin="8">
                                <CheckBox Name="ShowTargetCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Target" />
                                <CheckBox Name="ShowTimersCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Timers" />
                                <CheckBox Name="ShowCastBarCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Spellbar" />
                                <CheckBox Name="DynamicCastSpeedCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Dynamic Cast Speed"
                                          ToolTip="Adjust the catalog cast time using the OCR-read Dexterity and the configured casting-speed bonus." />
                                <CheckBox Name="EstimatedSpellDamageCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Estimated Spell Damage"
                                          ToolTip="Show a rough pre-resist estimate based on catalog damage, class acuity and the configured spell-damage bonus." />
                                <CheckBox Name="OcrReplayCheckbox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Record OCR Replay"
                                          ToolTip="Keep a bounded local history of changed OCR frames, recognized text and parser results for troubleshooting." />
                                <TextBox Width="90" Name="CastingSpeedBonusText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Cast Speed %"
                                         ToolTip="Enter the item or status-window casting-speed bonus. OCR keeps this value when the bonus is not visible." />
                                <TextBox Margin="8,0,0,0" Width="100" Name="SpellDamageBonusText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spell Damage %"
                                         ToolTip="Enter the item spell-damage bonus used by the optional rough damage estimate." />
                            </WrapPanel>
                        </GroupBox>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="{DynamicResource VsPanelBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Position / Size" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" Name="OverlayXText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target X" />
                                        <TextBox Margin="8,0,0,0" Width="90" Name="OverlayYText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Drag" Click="PickTargetOverlayPosition_Click" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" Name="OverlayTimerXText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer X" />
                                        <TextBox Margin="8,0,0,0" Width="90" Name="OverlayTimerYText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Drag" Click="PickTimerOverlayPosition_Click" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBox Width="90" Name="OverlayFontSizeText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Font" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Resize" Click="PickTargetSize_Click" />
                                        <TextBox Margin="8,0,0,0" Width="90" Name="OverlayTimerSizeText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Font" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Resize" Click="PickTimerSize_Click" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBox Width="90" Name="OverlayCastXText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spellbar X" />
                                        <TextBox Margin="8,0,0,0" Width="90" Name="OverlayCastYText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spellbar Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Drag" Click="PickCastOverlayPosition_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" Background="{DynamicResource VsPanelBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Colors" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="170" Name="TargetColorText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Color (#RRGGBB)" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Pick" Click="PickTargetColor_Click" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="170" Name="TimerColorText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Color (#RRGGBB)" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Pick" Click="PickTimerColor_Click" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBox Width="170" Name="OutlineColorText" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Outline Color (#RRGGBB)" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Content="Pick" Click="PickOutlineColor_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
