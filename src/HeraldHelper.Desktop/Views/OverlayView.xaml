<UserControl x:Class="HeraldHelper.Desktop.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource VsWindowBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="PreviewOverlay_Click" ToolTip="Render a demo target/timers/spellbar on the overlay windows so you can position and style them without being in-game">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Preview" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="ReloadOverlaySettings_Click" ToolTip="Discard unsaved edits and reload overlay settings from the database">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Reload" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}"
                                       Text="Changes apply automatically." />
                        </WrapPanel>

                        <!-- One row per overlay window — show/position/size/font are generated
                             uniformly from the element table in code-behind. -->
                        <GroupBox Grid.Row="1" Header="Overlay Elements"
                                  ToolTip="Every overlay window: visibility, screen position, font size and font family. Drag/Resize let you place it with the mouse while the preview is up.">
                            <StackPanel x:Name="OverlayElementsPanel" x:FieldModifier="public" Margin="4" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Target Info Fields"
                                  ToolTip="Choose which fields appear in the target overlay.">
                            <WrapPanel Margin="8">
                                <CheckBox x:Name="ShowGuildCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Guild" />
                                <CheckBox x:Name="ShowClassCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Class" />
                                <CheckBox x:Name="ShowLevelCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Level" />
                                <CheckBox x:Name="ShowRealmRankCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Realm Rank" />
                                <CheckBox x:Name="ShowSoloKillsCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Solo Kills" />
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="Sounds &amp; Behavior">
                            <StackPanel Margin="8,4">
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource VsMutedTextBrush}" Text="Sounds" />
                                <CheckBox x:Name="SoundsEnabledCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Enable"
                                          ToolTip="Master switch for audible alerts — off keeps the helper silent." />
                                <CheckBox x:Name="SoundSelfCcCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Self-CC"
                                          ToolTip="Alert when you get stunned/mesmerized/rooted." />
                                <CheckBox x:Name="SoundPeelCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="New attacker"
                                          ToolTip="Alert when an enemy first enters the peel list." />
                                <CheckBox x:Name="SoundInterruptCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Interrupt"
                                          ToolTip="Alert when your cast is interrupted." />
                                <CheckBox x:Name="SoundReadyCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="CC ready"
                                          ToolTip="Alert when a CC immunity expires on the current target and the category is open again." />
                                <TextBox Width="70" x:Name="OverlayOpacityText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Opacity %"
                                         ToolTip="Overlay opacity 30–100 (100 = fully opaque)." />
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="DynamicCastSpeedCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Dynamic Cast Speed"
                                          ToolTip="Adjust the catalog cast time using the OCR-read Dexterity and the configured casting-speed bonus." />
                                <CheckBox x:Name="EstimatedSpellDamageCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Estimated Spell Damage"
                                          ToolTip="Show a rough pre-resist estimate based on catalog damage, class acuity and the configured spell-damage bonus." />
                                <CheckBox x:Name="OcrReplayCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Record OCR Replay"
                                          ToolTip="Keep a bounded local history of changed OCR frames, recognized text and parser results for troubleshooting." />
                                <TextBox Width="90" x:Name="CastingSpeedBonusText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Cast Speed %"
                                         ToolTip="Enter the item or status-window casting-speed bonus. OCR keeps this value when the bonus is not visible." />
                                <TextBox Margin="8,0,0,0" Width="100" x:Name="SpellDamageBonusText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spell Damage %"
                                         ToolTip="Enter the item spell-damage bonus used by the optional rough damage estimate." />
                            </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <Border Grid.Row="4" Padding="10" Background="{DynamicResource VsPanelBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Colors" />
                                <CheckBox x:Name="UseRealmColorsCheckbox" x:FieldModifier="public" Margin="0,0,0,8" VerticalAlignment="Center" Content="Use realm colors for target overlay"
                                          ToolTip="Color the target overlay by the target's realm (Albion=red, Midgard=blue, Hibernia=green). Falls back to the Target Color when the realm is unknown." />
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBox Width="170" x:Name="TargetColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Color (#RRGGBB)" />
                                    <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                            BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                            Background="{Binding Text, ElementName=TargetColorText, Converter={StaticResource HexToBrush}}"
                                            ToolTip="Current color preview" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTargetColor_Click" ToolTip="Pick the target overlay color">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="Pick" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBox Width="170" x:Name="TimerColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Color (#RRGGBB)" />
                                    <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                            BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                            Background="{Binding Text, ElementName=TimerColorText, Converter={StaticResource HexToBrush}}"
                                            ToolTip="Current color preview" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTimerColor_Click" ToolTip="Pick the timer overlay color">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="Pick" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBox Width="170" x:Name="OutlineColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Outline Color (#RRGGBB)" />
                                    <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                            BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                            Background="{Binding Text, ElementName=OutlineColorText, Converter={StaticResource HexToBrush}}"
                                            ToolTip="Current color preview" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickOutlineColor_Click" ToolTip="Pick the overlay outline color">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="Pick" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>

</UserControl>
