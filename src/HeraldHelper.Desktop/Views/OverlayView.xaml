<UserControl x:Class="HeraldHelper.Desktop.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource VsWindowBackgroundBrush}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="ReloadOverlaySettings_Click" ToolTip="Reload overlay settings from the database">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Reload Overlay Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PreviewOverlay_Click" ToolTip="Render a demo target/timers/spellbar on the overlay windows so you can position and style them without being in-game">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Preview" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="SaveOverlaySettings_Click" ToolTip="Save overlay settings">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Save Overlay Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <GroupBox Grid.Row="1" Header="Overlay Elements">
                            <StackPanel>
                            <WrapPanel Margin="8">
                                <CheckBox x:Name="ShowTargetCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Target" />
                                <CheckBox x:Name="ShowTimersCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Timers" />
                                <CheckBox x:Name="ShowCastBarCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Spellbar" />
                                <CheckBox x:Name="ShowResistsCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Resists"
                                          ToolTip="Show Thrust/Slash/Crush for the target's armor class — green = weak to it, red = resists it." />
                                <!-- Group frames + buffs/pet read process memory (adapter feed) —
                                     experimental features stay hidden from the options UI. -->
                                <CheckBox x:Name="ShowGroupCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Group Frames" Visibility="Collapsed"
                                          ToolTip="Show group member frames (name, class, HP/End/Pow bars) — data comes from the client's group adapters, so it needs process-memory stats enabled (or a shard that feeds the adapter map). Not available in conservative mode." />
                                <CheckBox x:Name="ShowSelfCcCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Self-CC"
                                          ToolTip="Big banner when you get stunned/mesmerized/rooted — shows elapsed time since the CC landed." />
                                <CheckBox x:Name="ShowPeelCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Peel"
                                          ToolTip="List of enemies who attacked you recently (attacker + hit count) — who's trying to peel you." />
                                <CheckBox x:Name="ShowBuffsCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Show Buffs/Pet"
                                          ToolTip="Pet vitals plus active-effect names — adapter data, needs stats memory read. Effect names only fill while the summary window's icon grid renders." />
                                <CheckBox x:Name="DynamicCastSpeedCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Dynamic Cast Speed"
                                          ToolTip="Adjust the catalog cast time using the OCR-read Dexterity and the configured casting-speed bonus." />
                                <CheckBox x:Name="EstimatedSpellDamageCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Estimated Spell Damage"
                                          ToolTip="Show a rough pre-resist estimate based on catalog damage, class acuity and the configured spell-damage bonus." />
                                <CheckBox x:Name="OcrReplayCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Record OCR Replay"
                                          ToolTip="Keep a bounded local history of changed OCR frames, recognized text and parser results for troubleshooting." />
                                <TextBox Width="90" x:Name="CastingSpeedBonusText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Cast Speed %"
                                         ToolTip="Enter the item or status-window casting-speed bonus. OCR keeps this value when the bonus is not visible." />
                                <TextBox Margin="8,0,0,0" Width="100" x:Name="SpellDamageBonusText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spell Damage %"
                                         ToolTip="Enter the item spell-damage bonus used by the optional rough damage estimate." />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource VsMutedTextBrush}" Text="Sounds" />
                                <CheckBox x:Name="SoundsEnabledCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Enable"
                                          ToolTip="Master switch for audible alerts — off keeps the helper silent." />
                                <CheckBox x:Name="SoundSelfCcCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Self-CC"
                                          ToolTip="Alert when you get stunned/mesmerized/rooted." />
                                <CheckBox x:Name="SoundPeelCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="New attacker"
                                          ToolTip="Alert when an enemy first enters the peel list." />
                                <CheckBox x:Name="SoundInterruptCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Interrupt"
                                          ToolTip="Alert when your cast is interrupted." />
                                <TextBox Width="70" x:Name="OverlayOpacityText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Opacity %"
                                         ToolTip="Overlay opacity 30–100 (100 = fully opaque)." />
                            </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Target Info Fields"
                                  ToolTip="Choose which fields appear in the target overlay.">
                            <WrapPanel Margin="8">
                                <CheckBox x:Name="ShowGuildCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Guild" />
                                <CheckBox x:Name="ShowClassCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Class" />
                                <CheckBox x:Name="ShowLevelCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Level" />
                                <CheckBox x:Name="ShowRealmRankCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Realm Rank" />
                                <CheckBox x:Name="ShowSoloKillsCheckbox" x:FieldModifier="public" Margin="0,0,16,0" VerticalAlignment="Center" Content="Solo Kills" />
                            </WrapPanel>
                        </GroupBox>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="{DynamicResource VsPanelBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Position / Size" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTargetOverlayPosition_Click" ToolTip="Drag the target overlay position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayTimerXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayTimerYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTimerOverlayPosition_Click" ToolTip="Drag the timer overlay position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayCastXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spellbar X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayCastYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Spellbar Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickCastOverlayPosition_Click" ToolTip="Drag the castbar overlay position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayResistsXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Resists X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayResistsYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Resists Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickResistsOverlayPosition_Click" ToolTip="Drag the resists overlay position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBox Width="90" x:Name="OverlayGroupXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Group X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayGroupYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Group Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickGroupOverlayPosition_Click" ToolTip="Drag the group frames position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlaySelfCcXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Self-CC X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlaySelfCcYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Self-CC Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickSelfCcOverlayPosition_Click" ToolTip="Drag the self-CC banner position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayPeelXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Peel X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayPeelYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Peel Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickPeelOverlayPosition_Click" ToolTip="Drag the peel list position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="90" x:Name="OverlayBuffXText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Buffs X" />
                                        <TextBox Margin="8,0,0,0" Width="90" x:Name="OverlayBuffYText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Buffs Y" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickBuffOverlayPosition_Click" ToolTip="Drag the buff list position">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CursorMove" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Drag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <ComboBox Width="140" x:Name="OverlayTargetFontCombo" x:FieldModifier="public" Style="{StaticResource CompactInputComboBoxStyle}" materialDesign:HintAssist.Hint="Target Font" />
                                        <TextBox Margin="8,0,0,0" Width="60" x:Name="OverlayFontSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTargetSize_Click" ToolTip="Resize the target overlay">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Resize" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ComboBox Width="140" x:Name="OverlayTimerFontCombo" x:FieldModifier="public" Style="{StaticResource CompactInputComboBoxStyle}" materialDesign:HintAssist.Hint="Timer Font" />
                                        <TextBox Margin="8,0,0,0" Width="60" x:Name="OverlayTimerSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTimerSize_Click" ToolTip="Resize the timer overlay">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Resize" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ComboBox Width="140" x:Name="OverlayCastbarFontCombo" x:FieldModifier="public" Style="{StaticResource CompactInputComboBoxStyle}" materialDesign:HintAssist.Hint="Spellbar Font" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Width="140" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Text="Resists (target font)" />
                                        <TextBox Width="60" x:Name="OverlayResistsSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickResistsSize_Click" ToolTip="Resize the resists overlay">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Resize" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Width="140" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Text="Group (timer font)" />
                                        <TextBox Width="60" x:Name="OverlayGroupSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Width="140" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Text="Self-CC (target font)" />
                                        <TextBox Width="60" x:Name="OverlaySelfCcSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Width="140" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Text="Peel (timer font)" />
                                        <TextBox Width="60" x:Name="OverlayPeelSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Width="140" VerticalAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Text="Buffs (timer font)" />
                                        <TextBox Width="60" x:Name="OverlayBuffSizeText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Size" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" Background="{DynamicResource VsPanelBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Colors" />
                                    <CheckBox x:Name="UseRealmColorsCheckbox" x:FieldModifier="public" Margin="0,0,0,8" VerticalAlignment="Center" Content="Use realm colors for target overlay"
                                              ToolTip="Color the target overlay by the target's realm (Albion=red, Midgard=blue, Hibernia=green). Falls back to the Target Color when the realm is unknown." />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="170" x:Name="TargetColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Target Color (#RRGGBB)" />
                                        <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                                BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                                Background="{Binding Text, ElementName=TargetColorText, Converter={StaticResource HexToBrush}}"
                                                ToolTip="Current color preview" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTargetColor_Click" ToolTip="Pick the target overlay color">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Pick" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox Width="170" x:Name="TimerColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Timer Color (#RRGGBB)" />
                                        <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                                BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                                Background="{Binding Text, ElementName=TimerColorText, Converter={StaticResource HexToBrush}}"
                                                ToolTip="Current color preview" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickTimerColor_Click" ToolTip="Pick the timer overlay color">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Pick" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBox Width="170" x:Name="OutlineColorText" x:FieldModifier="public" Style="{StaticResource CompactInputTextBoxStyle}" materialDesign:HintAssist.Hint="Outline Color (#RRGGBB)" />
                                        <Border Width="18" Height="18" Margin="6,6,0,0" CornerRadius="3"
                                                BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                                                Background="{Binding Text, ElementName=OutlineColorText, Converter={StaticResource HexToBrush}}"
                                                ToolTip="Current color preview" />
                                        <Button Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="PickOutlineColor_Click" ToolTip="Pick the overlay outline color">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Eyedropper" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Pick" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

</UserControl>
