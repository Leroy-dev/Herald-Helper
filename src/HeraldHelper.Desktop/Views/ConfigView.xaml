<UserControl x:Class="HeraldHelper.Desktop.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource VsWindowBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="DAoC Characters">
                            <StackPanel x:Name="DaocCharacterPanel" x:FieldModifier="public" />
                        </GroupBox>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="ReloadConfig_Click" ToolTip="Reload the current configuration from the database">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Reload Config" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="SaveConfig_Click" ToolTip="Save the configuration grid to the database">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Save Config" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExportJson_Click" ToolTip="Export all settings to a JSON backup file">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Export JSON" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="ImportJson_Click" ToolTip="Import settings from a JSON backup file">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileImport" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Import JSON" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButtonStyle}" Click="CheckUpdates_Click" ToolTip="Check GitHub for a newer release">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Check Updates" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="ConservativeModeCheckbox" x:FieldModifier="public"
                                      Margin="14,0,0,0" VerticalAlignment="Center"
                                      Content="Conservative mode — never touch the game process"
                                      ToolTip="Master switch for process memory access. When on, memory chat read, scrollback chat, and live stats/adapters are all disabled — chat still flows via OCR, chat.log, and the Blackthorn relay. Takes effect immediately."
                                      Click="ConservativeMode_Click" />
                        </WrapPanel>
                        <GroupBox Grid.Row="2" Header="Custom UI package (bitmap font OCR)">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CustomUiFolderText" x:FieldModifier="public"
                                         Width="380"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource CompactInputTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Auto-detect from launcher (or pick a game folder, ui\custom package, or uimain.xml)"
                                         ToolTip="Folder HeraldHelper reads window fonts from for bitmap OCR. Empty = auto-detect from the Eden/Blackthorn launcher. Accepts a game folder, a ui\custom package folder, or a uimain.xml file."
                                         LostFocus="CustomUiFolder_LostFocus" />
                                <Button Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="CustomUiFolderBrowse_Click"
                                        ToolTip="Browse for the UI package folder">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Browse" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="CustomUiFolderClear_Click"
                                        ToolTip="Clear the override and auto-detect again">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="3" Header="Setup checklist"
                                  ToolTip="Live sanity check of everything the helper needs — sources, elevation, UI package, catalogs.">
                            <ItemsControl x:Name="SetupChecklistList" x:FieldModifier="public" Margin="8,2,8,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Width="18" VerticalAlignment="Top" FontWeight="Bold"
                                                       Foreground="{Binding Ok, Converter={StaticResource ChecklistGlyphColor}}"
                                                       Text="{Binding Ok, Converter={StaticResource ChecklistGlyph}}"/>
                                            <TextBlock Width="190" VerticalAlignment="Top" FontWeight="SemiBold" Text="{Binding Name}"/>
                                            <TextBlock Foreground="{DynamicResource VsMutedTextBrush}" Text="{Binding Hint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                        <GroupBox Grid.Row="4" Header="Shard auth (auto-refresh)"
                                  ToolTip="Per-shard login settings. Enable a shard and set its hub URL to let the Auth button and the auto-refresh timer harvest cookies. The refresh itself runs headless — use the Login toolbar button to sign in once.">
                            <StackPanel>
                                <DataGrid x:Name="ShardAuthGrid" x:FieldModifier="public"
                                          Margin="0,8,0,0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="False"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Shard" Binding="{Binding Shard}" Width="80" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        <DataGridTextColumn Header="Hub URL" Binding="{Binding HubUrl, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <DataGridTextColumn Header="Cookies" Binding="{Binding CookieNames, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                        <DataGridTextColumn Header="Required" Binding="{Binding RequiredCookies, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                        <DataGridTextColumn Header="Validate URL" Binding="{Binding ValidateUrl, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Binding="{Binding HubDeny, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="Hub deny" ToolTip="|-separated phrases in the hub page's visible text that mean 'not logged in' — e.g. Eden's LOGIN nav button. Cookies are only captured once the page stops showing them."/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="120" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="SaveShardAuth_Click"
                                        ToolTip="Save the shard auth table">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Save Auth Settings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                        <Expander Grid.Row="5"
                                  Header="Advanced raw configuration"
                                  IsExpanded="False"
                                  Foreground="{DynamicResource VsTextBrush}"
                                  Background="{DynamicResource VsPanelBrush}"
                                  BorderBrush="{DynamicResource VsBorderBrush}">
                            <StackPanel>
                            <TextBox Margin="0,8,0,0"
                                     Width="240"
                                     HorizontalAlignment="Left"
                                     x:Name="ConfigFilterText" x:FieldModifier="public"
                                     Style="{StaticResource CompactInputTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="Filter settings"
                                     ToolTip="Filter raw settings by key or value"
                                     TextChanged="ConfigFilter_TextChanged" />
                            <DataGrid x:Name="ConfigGrid" x:FieldModifier="public"
                                      Margin="0,8,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      HeadersVisibility="Column"
                                      IsReadOnly="False"
                                      MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="300" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </StackPanel>
                        </Expander>
                    </Grid>
                    </ScrollViewer>

</UserControl>
