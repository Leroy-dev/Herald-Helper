<UserControl x:Class="HeraldHelper.Desktop.Views.HeraldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource VsWindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,10">
            <TextBox Width="240"
                     x:Name="HeraldSearchText" x:FieldModifier="public"
                     Style="{StaticResource CompactInputTextBoxStyle}"
                     materialDesign:HintAssist.Hint="Player name"
                     ToolTip="Search cached player profiles by name (substring)"
                     TextChanged="HeraldSearch_TextChanged" />
            <ComboBox Margin="8,0,0,0"
                      Width="140"
                      x:Name="HeraldShardCombo" x:FieldModifier="public"
                      Style="{StaticResource CompactInputComboBoxStyle}"
                      materialDesign:HintAssist.Hint="Shard"
                      ToolTip="Restrict the search to one shard"
                      SelectionChanged="HeraldShard_SelectionChanged">
                <ComboBoxItem Content="All shards" IsSelected="True" />
                <ComboBoxItem Content="Eden" />
                <ComboBoxItem Content="Blackthorn" />
            </ComboBox>
            <TextBlock Margin="12,0,0,0"
                       x:Name="HeraldResultText" x:FieldModifier="public"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource VsMutedTextBrush}" />
            <Button Margin="12,0,0,0"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="HeraldRemove_Click"
                    ToolTip="Delete the selected cached profile — stale or renamed characters keep their old entry otherwise">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountRemove" Width="15" Height="15" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Forget" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <GroupBox Grid.Row="1" Header="Cached players">
            <TextBlock Margin="4,0,0,4"
                       FontSize="11"
                       Foreground="{DynamicResource VsMutedTextBrush}"
                       Text="Profiles are keyed by shard + name — a Leroy on Eden and a Leroy on Blackthorn are two separate entries." />
        </GroupBox>

        <DataGrid Grid.Row="2"
                  x:Name="HeraldResultsGrid" x:FieldModifier="public"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="90" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="110" />
                <DataGridTextColumn Header="Realm" Binding="{Binding Realm}" Width="85" />
                <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="50" />
                <DataGridTextColumn Header="Realm Rank" Binding="{Binding RealmRank}" Width="90" />
                <DataGridTextColumn Header="Solo Kills" Binding="{Binding SoloKills}" Width="80" />
                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedUtc}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
